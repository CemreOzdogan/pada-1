{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "suggestion-request.schema.json",
  "title": "SuggestionRequest",
  "type": "object",
  "required": ["scheme", "locked"],
  "properties": {
    "scheme": { "enum": ["ml-kem", "ml-dsa"] },
    "locked": {
      "type": "object",
      "description": "partial ParameterSet — the fields to hold fixed while suggesting neighbors"
    },
    "target_security_bits": { "type": "number" }
  }
}
