{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "advisor-result.schema.json",
  "title": "AdvisorResult",
  "type": "object",
  "required": ["parameter_set", "security_bits", "sizes_bytes", "is_standard", "source"],
  "properties": {
    "parameter_set": { "$ref": "parameter-set.schema.json" },
    "security_bits": {
      "type": "object",
      "required": ["classical", "quantum", "attacks"],
      "properties": {
        "classical": { "type": "number" },
        "quantum": { "type": "number" },
        "attacks": {
          "type": "object",
          "properties": {
            "primal": { "type": "number" },
            "dual": { "type": "number" },
            "hybrid": { "type": "number" },
            "sis": { "type": ["number", "null"], "description": "DSA only" }
          }
        }
      }
    },
    "failure_log2": {
      "type": ["number", "null"],
      "description": "KEM decryption-failure probability, log2; null for DSA"
    },
    "consistency": {
      "type": ["object", "null"],
      "description": "DSA bound consistency checks; null for KEM"
    },
    "sizes_bytes": {
      "type": "object",
      "required": ["pk", "sk"],
      "properties": {
        "pk": { "type": "integer" },
        "sk": { "type": "integer" },
        "ct": { "type": "integer" },
        "sig": { "type": "integer" }
      }
    },
    "is_standard": { "type": "boolean" },
    "nist_category": { "type": ["integer", "null"], "enum": [1, 2, 3, 4, 5, null] },
    "source": {
      "enum": ["hardcoded", "precomputed-grid", "live-sage"],
      "description": "provenance of these numbers"
    }
  }
}
